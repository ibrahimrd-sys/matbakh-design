#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# Matbakh — pre-commit guard.
#
# Runs on every commit, whatever made it: Git Bash, GitHub Desktop, VS Code.
#
# Scope is deliberately narrow. It checks FILENAMES and COUNTS only — never
# file contents. Content scanning caused three false positives (tokens.css,
# media.js twice) and blocked nothing real. A guard that cries wolf is a guard
# you learn to bypass, so the deeper scan moved to scan.sh, which is advisory
# and run on demand.
#
# What this cannot catch: a key pasted inline into a tracked text file. That is
# what 06-credentials/ in the vault is for. Keep secrets in files, not in code.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FAIL=0
report() { echo "  BLOCKED  $1"; FAIL=1; }

# ── 1. The vault, or anything carrying its marker ───────────────────────────
HITS=$(echo "$STAGED" | grep -Ei 'matbakh-private|DO-NOT-COMMIT' || true)
[ -n "$HITS" ] && while read -r f; do
  report "$f — belongs in ../matbakh-private/, outside this repository"
done <<< "$HITS"

# ── 2. Business documents ───────────────────────────────────────────────────
HITS=$(echo "$STAGED" | grep -Ei '\.(xlsx|xlsm|xls|docx|doc|pptx|ppt|numbers|pages)$' || true)
[ -n "$HITS" ] && while read -r f; do
  report "$f — financial model and strategy documents stay in the vault"
done <<< "$HITS"

# ── 3. Credential files, by name ────────────────────────────────────────────
HITS=$(echo "$STAGED" | grep -Ei '(^|/)\.env|\.pem$|\.p12$|\.pfx$|\.keystore$|id_rsa|\.ppk$|(^|/)secrets?\.|credentials?\.' || true)
[ -n "$HITS" ] && while read -r f; do
  report "$f — looks like a credential file"
done <<< "$HITS"

# ── 4. The recipe catalogue ─────────────────────────────────────────────────
HITS=$(echo "$STAGED" | grep -E '^content/recipes/' \
       | grep -vE '_template\.yaml$|molokhia_bil_farakh\.yaml$|README\.md$' || true)
if [ -n "$HITS" ]; then
  N=$(echo "$HITS" | wc -l | tr -d ' ')
  report "$N recipe file(s) beyond the template and the demo"
  echo "$HITS" | head -5 | sed 's/^/             /'
  echo "             The catalogue is the product. It lives in the vault."
fi

if [ "$FAIL" -ne 0 ]; then
  echo
  echo "  COMMIT STOPPED. Nothing has been committed."
  echo "  Move these to ../matbakh-private/, then:  git restore --staged <file>"
  echo
  exit 1
fi
exit 0
